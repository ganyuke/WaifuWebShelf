# Settings for the service. Restart after changing: sudo systemctl restart waifuwebshelf

# Accept connections from the local reverse proxy only
HOST=127.0.0.1
PORT=8080
DATA_DIR=/opt/waifuwebshelf/data

# Set your site's address to show pictures in chat previews
# SITE_URL=https://shelf.example.com

# Set a password, or leave it out to get a random one in data/admin-password
# ADMIN_PASS=

# Add your reverse proxy's address when it runs on another machine
# TRUSTED_PROXIES=127.0.0.1,::1
